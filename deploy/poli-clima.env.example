# Se copia a /etc/poli-clima.env (systemd) — ver .env.example para todas las variables.
PORT=8080
HOST=127.0.0.1                      # solo escucha en la propia máquina; Nginx publica hacia afuera
TRUST_PROXY=true                    # SOLO porque Nginx está delante y envía X-Forwarded-For
DB_FILE=/var/lib/poli-clima/poli-clima.db
LOG_LEVEL=info
