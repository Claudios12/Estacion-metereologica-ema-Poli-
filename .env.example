# Configuración de Poli Clima. Copiar como .env y ejecutar:  node --env-file=.env server.mjs
# Todas son opcionales; si un valor es inválido, el servidor NO arranca y explica el error.

# --- Servidor ---
PORT=8080
HOST=0.0.0.0

# --- Estación (32 caracteres hexadecimales) ---
STATION_ID=78e4ae1ed0d046f480fe79dc04e7ef23

# --- Consulta a WeatherLink ---
CACHE_TTL_MS=60000            # tiempo que se reutiliza una respuesta (mín. 10000)
STALE_MAX_MS=1800000          # si WeatherLink falla, se sirve el último dato bueno hasta esta antigüedad
UPSTREAM_TIMEOUT_MS=5000      # tiempo máximo de espera a WeatherLink
UPSTREAM_MAX_BYTES=262144     # tamaño máximo aceptado de la respuesta
STATION_STALE_MIN=30          # minutos sin reporte de la estación para marcarla como desactualizada

# --- Control de tasas por IP ---
RATE_LIMIT_WINDOW_MS=60000    # ventana de conteo
RATE_LIMIT_MAX=120            # solicitudes por IP y ventana (todas las rutas)
RATE_LIMIT_MAX_API=30         # solicitudes por IP y ventana a /api/weather
RATE_LIMIT_MAX_CLIENTS=50000  # IPs distintas que se recuerdan en memoria
TRUST_PROXY=false             # true SOLO si hay un proxy inverso (Nginx, IIS, balanceador) delante

# --- Logging ---
LOG_LEVEL=info                # debug | info | warn | error | fatal
# LOG_FILE=./logs/poli-clima.log   # además de la consola, escribe los eventos en este archivo

# --- Base de datos (SQLite, módulo integrado de Node 22.13+) ---
DB_ENABLED=true
DB_FILE=data/poli-clima.db     # ruta relativa a la carpeta del proyecto
COLLECT_INTERVAL_MS=300000    # cada cuánto se guarda una lectura (mín. 60000 = 1 min)
HISTORY_MAX_DAYS=31           # días máximos por consulta a /api/historico

# --- Quién puede ver el histórico y /api/status (ver README) ---
# Se crean con:  npm run crear-clave -- analista    y    npm run crear-clave -- administrador
# (guardan aquí solo la huella de la contraseña). SIN estas líneas, el histórico y /api/status quedan CERRADOS.
# ANALYST_USER=analista
# ANALYST_PASSWORD_HASH=scrypt:16384:8:1:...
# ADMIN_USER=admin
# ADMIN_PASSWORD_HASH=scrypt:16384:8:1:...
AUTH_FAIL_MAX=10              # intentos fallidos por IP antes de bloquearla
AUTH_FAIL_WINDOW_MS=300000    # duración de la ventana y del bloqueo (5 min)
SESSION_TTL_MS=28800000       # duración de una sesión iniciada desde la página (8 h)
